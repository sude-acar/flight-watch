# Local development: SQLite file, no cloud cost.
# Later (Cloud SQL): postgresql+psycopg://USER:PASSWORD@HOST:5432/flightwatch
DATABASE_URL=sqlite:///flightwatch.db

# OpenSky API client (optional; without it requests are anonymous with a lower
# rate limit). Create one at opensky-network.org -> Account -> API client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Reuse an OpenSky fetch for this many seconds (0 = no cache)
OPENSKY_CACHE_SECONDS=15
# Optional tuning
# OPENSKY_TIMEOUT=10
# OPENSKY_RETRIES=2
# OPENSKY_AIRPORT_RADIUS=0.5
