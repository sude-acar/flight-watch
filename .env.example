# Local development: SQLite file, no cloud cost.
DATABASE_URL=sqlite:///flightwatch.db

# Cloud SQL: when INSTANCE_CONNECTION_NAME is set, DATABASE_URL is ignored.
# Needs Google credentials: `gcloud auth application-default login` locally,
# a service account on GKE.
# INSTANCE_CONNECTION_NAME=dsai523-510708:europe-west1:flightwatch-db
# DB_USER=flightwatch
# DB_PASSWORD=change-me
# DB_NAME=flightwatch
