# Local development: SQLite file, no cloud cost.
DATABASE_URL=sqlite:///flightwatch.db

# Cloud SQL: when INSTANCE_CONNECTION_NAME is set, DATABASE_URL is ignored.
# Needs Google credentials: `gcloud auth application-default login` locally,
# Workload Identity on GKE (see README "Cloud SQL").
# INSTANCE_CONNECTION_NAME=dsai523-510708:europe-west1:flightwatch-db
# DB_USER=flightwatch
# DB_PASSWORD=
# DB_NAME=flightwatch

# Flight data source: adsblol (default, works from GCP) or opensky (blocked on GCP)
FLIGHT_SOURCE=adsblol
# Reuse a flight data fetch for this many seconds (0 = no cache).
# adsb.lol allows 500 requests/day per IP without a key, so keep this on.
FLIGHT_CACHE_SECONDS=15
# Half-size in degrees of the box around an airport
# AIRPORT_RADIUS=0.5

# adsb.lol (optional key raises the daily limit: https://www.adsb.lol/mmb)
ADSBLOL_API_KEY=
# ADSBLOL_TIMEOUT=10
# ADSBLOL_RETRIES=2

# OpenSky (only used with FLIGHT_SOURCE=opensky; optional API client for a
# higher limit: opensky-network.org -> Account -> API client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# OPENSKY_TIMEOUT=10
# OPENSKY_RETRIES=2
