# Local development: SQLite file, no cloud cost.
DATABASE_URL=sqlite:///flightwatch.db

# Cloud SQL: when INSTANCE_CONNECTION_NAME is set, DATABASE_URL is ignored.
# Needs Google credentials: `gcloud auth application-default login` locally,
# Workload Identity on GKE (see README "Cloud SQL").
# INSTANCE_CONNECTION_NAME=dsai523-510708:europe-west1:flightwatch-db
# DB_USER=flightwatch
# DB_PASSWORD=
# DB_NAME=flightwatch

# OpenSky API client (optional; without it requests are anonymous with a lower
# rate limit). Create one at opensky-network.org -> Account -> API client.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Reuse an OpenSky fetch for this many seconds (0 = no cache)
OPENSKY_CACHE_SECONDS=15
# Optional tuning
# OPENSKY_TIMEOUT=10
# OPENSKY_RETRIES=2
# OPENSKY_AIRPORT_RADIUS=0.5
